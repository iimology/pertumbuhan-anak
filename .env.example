# Salin menjadi .env (file .env tidak ikut Git).
# Port yang dibuka di server/VPS (port di dalam container tetap 5000).
APP_PORT=5000

# Opsional. Jika kosong, aplikasi membuat kunci sendiri dan menyimpannya di
# folder data (data/.secret_key). Isi hanya jika ingin menentukan sendiri.
# Buat dengan: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
